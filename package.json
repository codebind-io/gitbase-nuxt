{
  "name": "nuxt-cms",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "generate": "pnpm run build",
    "dev": "nuxt dev",
    "cms:local": "node scripts/use-local-cms.mjs",
    "dev:c": "nuxt cleanup && nuxt dev",
    "clean": "nuxt cleanup",
    "stop": "taskkill /F /IM node.exe 2>nul",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "amend": "git commit --amend --no-edit && git push --force-with-lease"
  },
  "dependencies": {
    "@gitbase/cms": "^0.1.4",
    "@iconify-json/lucide": "1.2.142",
    "@iconify-json/simple-icons": "1.2.99",
    "@nuxt/content": "3.16.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "4.11.3",
    "@nuxtjs/mdc": "0.23.2",
    "@takumi-rs/core": "2.14.0",
    "@vueuse/nuxt": "15.0.0",
    "better-sqlite3": "13.0.3",
    "motion-v": "2.6.0",
    "nuxt": "4.6.1",
    "nuxt-og-image": "6.10.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "eslint": "10.12.0",
    "typescript": "^6.0.3",
    "vue-tsc": "3.3.12"
  },
  "packageManager": "pnpm@12.10.1"
}
